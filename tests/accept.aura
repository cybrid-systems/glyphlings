(require "aura/driver" all:)
(require "aura/project" all:)
(require "std/mutate" all:)

(define *bad* #f)
(define (ok? label yes)
  (if (equal? yes #t)
    #t
    (begin
      (display "GLYPHLINGS_FAIL ")
      (display label)
      (newline)
      (set! *bad* #t))))

(ok? "install" (equal? (glyphlings:install! "tests/fixtures/cat-word.aura") #t))
(define epoch0 (stats:get "compile:epoch"))
(define t0 (monotonic-ms))
(glyphlings:on-line "C")
(define ms1 (- (monotonic-ms) t0))
(define paint1 (glyphlings:key-ms))
(define src (current-source :workspace))
(display (mutate:last-info))
(newline)
(ok? "head" (string=? (glyphlings:inner src "creature-head")
                      (glyphlings:inner src "part-cat-word-1-head")))
(ok? "expect-a" (string=? (glyphlings:inner src "expect") "a"))
(ok? "cell-a" (string=? (glyphlings:cell "expect") "a"))
(ok? "cell-head" (string=? (glyphlings:cell "creature-head")
                           (glyphlings:inner src "creature-head")))
(ok? "progress-1" (= (glyphlings:num src "progress") 1))
(ok? "cell-progress" (= (glyphlings:cell "progress") 1))
(ok? "epoch-same" (= (glyphlings:num src "epoch") 0))
(ok? "zoo-empty" (string=? (glyphlings:inner src "zoo") ""))
(define epoch1 (stats:get "compile:epoch"))
(ok? "compile-epoch" (and (number? epoch0) (number? epoch1) (> epoch1 epoch0)))
(define t1 (monotonic-ms))
(glyphlings:on-line "a")
(define ms2 (- (monotonic-ms) t1))
(define paint2 (glyphlings:key-ms))
(define src2 (current-source :workspace))
(ok? "body" (string=? (glyphlings:inner src2 "creature-body")
                      (glyphlings:inner src2 "part-cat-word-2-body")))
(ok? "expect-t" (string=? (glyphlings:inner src2 "expect") "t"))
(ok? "cell-t" (string=? (glyphlings:cell "expect") "t"))
(ok? "progress-2" (= (glyphlings:num src2 "progress") 2))
(ok? "still-no-zoo" (string=? (glyphlings:inner src2 "zoo") ""))
(display "ms ")
(display ms1)
(display " ")
(display ms2)
(display " paint ")
(display paint1)
(display " ")
(display paint2)
(newline)
(ok? "ms1" (< ms1 180))
(ok? "ms2" (< ms2 180))
(ok? "paint1" (< paint1 180))
(ok? "paint2" (< paint2 180))
(ok? "seed" (equal? (glyphlings:install! "aura/seed.aura") #t))
(define t2 (monotonic-ms))
(glyphlings:on-line "c")
(define ms3 (- (monotonic-ms) t2))
(define paint3 (glyphlings:key-ms))
(define hatched (current-source :workspace))
(display "hatch-ms ")
(display ms3)
(display " paint ")
(display paint3)
(newline)
(ok? "hatch-ms" (< ms3 900))
(ok? "hatch-paint" (< paint3 420))
(ok? "letter-epoch" (= (glyphlings:num hatched "epoch") 1))
(ok? "letter-kind" (string=? (glyphlings:inner hatched "creature-kind") "dog"))
(ok? "letter-expect" (string=? (glyphlings:inner hatched "expect") "d"))
(ok? "letter-cell" (string=? (glyphlings:cell "expect") "d"))
(if (equal? *bad* #t)
  (display "GLYPHLINGS_FAIL\n")
  (display "GLYPHLINGS_OK\n"))
