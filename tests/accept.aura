(require "aura/driver" all:)
(require "aura/project" all:)
(require "std/mutate" all:)

(define *bad* #f)
(define (ok? label yes)
  (if (equal? yes #t)
    #t
    (begin
      (display "GLYPHLINGS_FAIL ")
      (display label)
      (newline)
      (set! *bad* #t))))

(ok? "install" (equal? (glyphlings:install! "tests/fixtures/cat-word.aura") #t))
(define epoch0 (stats:get "compile:epoch"))
(define t0 (monotonic-ms))
(glyphlings:on-line "C")
(define src (current-source :workspace))
(display (mutate:last-info))
(newline)
(ok? "head" (string=? (glyphlings:inner src "creature-head")
                      (glyphlings:inner src "part-cat-word-1-head")))
(ok? "expect-a" (string=? (glyphlings:inner src "expect") "a"))
(ok? "progress-1" (= (glyphlings:num src "progress") 1))
(ok? "epoch-same" (= (glyphlings:num src "epoch") 0))
(ok? "zoo-empty" (string=? (glyphlings:inner src "zoo") ""))
(define epoch1 (stats:get "compile:epoch"))
(ok? "compile-epoch" (and (number? epoch0) (number? epoch1) (> epoch1 epoch0)))
(glyphlings:on-line "a")
(define src2 (current-source :workspace))
(ok? "body" (string=? (glyphlings:inner src2 "creature-body")
                      (glyphlings:inner src2 "part-cat-word-2-body")))
(ok? "expect-t" (string=? (glyphlings:inner src2 "expect") "t"))
(ok? "progress-2" (= (glyphlings:num src2 "progress") 2))
(ok? "still-no-zoo" (string=? (glyphlings:inner src2 "zoo") ""))
(display "ms ")
(display (- (monotonic-ms) t0))
(newline)
(if (equal? *bad* #t)
  (display "GLYPHLINGS_FAIL\n")
  (display "GLYPHLINGS_OK\n"))
