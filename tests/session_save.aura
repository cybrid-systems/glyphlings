(require "aura/driver" all:)
(require "aura/project" all:)

(define *bad* #f)
(define (ok? label yes)
  (if (equal? yes #t)
    #t
    (begin
      (display "GLYPHLINGS_FAIL ")
      (display label)
      (newline)
      (set! *bad* #t))))

(ok? "install" (equal? (glyphlings:install! "aura/seed.aura") #t))
(glyphlings:on-line "c")
(ok? "epoch" (= (glyphlings:num (current-source :workspace) "epoch") 1))
(ok? "save" (equal? (glyphlings:save) #t))
(if (equal? *bad* #t)
  (display "GLYPHLINGS_FAIL\n")
  (display "GLYPHLINGS_OK\n"))
