(require "aura/driver" all:)
(require "aura/project" all:)
(require "aura/spawn" all:)
(require "std/mutate" all:)

(define *bad* #f)
(define (ok? label yes)
  (if (equal? yes #t)
    #t
    (begin
      (display "GLYPHLINGS_FAIL ")
      (display label)
      (newline)
      (set! *bad* #t))))

(set-code (read-file "aura/seed.aura"))
(eval-current)
(define id (ast:snapshot "id0"))
(ok? "id0" (= id 0))
(define snap-src (current-source :workspace))
(define found (query :find "live"))
(define lit (car (query :children (car found))))
(define wrote (mutate:atomic-batch
  (list (list "mutate:replace-value" lit "z" "id0"))
  "id0"
  :sync-query-index? #f))
(ok? "wrote" (equal? wrote #t))
(ok? "changed" (equal? (equal? snap-src (current-source :workspace)) #f))
(define restored (ast:restore 0))
(ok? "restore0" (equal? restored #t))
(eval-current)
(ok? "back" (equal? snap-src (current-source :workspace)))

(define (show-choice label misses kind epoch)
  (let ((r (glyphlings:choose (current-source :workspace) misses kind epoch)))
    (display label)
    (display " ")
    (display (car r))
    (display "/")
    (display (car (cdr r)))
    (newline)
    r))

(define none (hash))
(define only-c (hash "c" 1))
(ok? "zero-cat" (equal? (show-choice "zero-cat" none "cat" 0) (list "dog" "letter")))
(ok? "zero-dog" (equal? (show-choice "zero-dog" none "dog" 0) (list "bee" "letter")))
(ok? "zero-ant" (equal? (show-choice "zero-ant" none "ant" 0) (list "cat" "letter")))
(ok? "late-dog" (equal? (show-choice "late-dog" none "dog" 2) (list "bee" "word")))
(ok? "late-ant" (equal? (show-choice "late-ant" none "ant" 2) (list "cat" "word")))
(ok? "hot-cat" (equal? (show-choice "hot-cat" only-c "cat" 0) (list "cat" "word")))
(ok? "hot-dog" (equal? (show-choice "hot-dog" only-c "dog" 2) (list "cat" "word")))
(ok? "hot-ant" (equal? (show-choice "hot-ant" only-c "ant" 0) (list "cat" "word")))

(ok? "fixture" (equal? (glyphlings:install! "tests/fixtures/cat-word.aura") #t))
(glyphlings:on-line "c")
(glyphlings:on-line "a")
(glyphlings:on-line "t")
(define hatched (current-source :workspace))
(ok? "zoo" (glyphlings:contains? (glyphlings:inner hatched "zoo") "🐱🐈🐾"))
(ok? "epoch1" (= (glyphlings:num hatched "epoch") 1))
(ok? "next-kind" (string=? (glyphlings:inner hatched "creature-kind") "dog"))
(ok? "next-mode" (string=? (glyphlings:inner hatched "spawn-mode") "letter"))
(ok? "next-expect" (string=? (glyphlings:inner hatched "expect") "d"))
(ok? "next-progress" (= (glyphlings:num hatched "progress") 0))
(define before-spawn (glyphlings:value-src hatched "next-spawn"))
(define bad (glyphlings:commit-spawn! hatched "nope" "letter"))
(ok? "nope" (equal? (equal? (car bad) #t) #f))
(ok? "spawn-same" (equal? before-spawn
                          (glyphlings:value-src (current-source :workspace) "next-spawn")))

(ok? "seed" (equal? (glyphlings:install! "aura/seed.aura") #t))
(glyphlings:on-line "c")
(define letter-src (current-source :workspace))
(ok? "letter-epoch" (= (glyphlings:num letter-src "epoch") 1))
(ok? "letter-zoo" (glyphlings:contains? (glyphlings:inner letter-src "zoo") "🐱"))
(ok? "next-is-dog" (string=? (glyphlings:inner letter-src "creature-kind") "dog"))
(glyphlings:on-line "d")
(glyphlings:on-line "b")
(define grown (current-source :workspace))
(ok? "kept-playing" (= (glyphlings:num grown "epoch") 3))
(ok? "now-word" (string=? (glyphlings:inner grown "spawn-mode") "word"))
(ok? "now-sun" (string=? (glyphlings:inner grown "creature-kind") "sun"))
(ok? "now-s" (string=? (glyphlings:inner grown "expect") "s"))
(ok? "egg-again" (string=? (glyphlings:inner grown "creature-head") "🥚"))
(ok? "zoo-grew" (and (glyphlings:contains? (glyphlings:inner grown "zoo") "🐱")
                     (glyphlings:contains? (glyphlings:inner grown "zoo") "🐶")
                     (glyphlings:contains? (glyphlings:inner grown "zoo") "🐝")))

(if (equal? *bad* #t)
  (display "GLYPHLINGS_FAIL\n")
  (display "GLYPHLINGS_OK\n"))
