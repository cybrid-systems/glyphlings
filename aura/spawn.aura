; Next animal is one of the 16 lambdas already in the workspace.
; The kind order is the order of label-* in that same source.
; Epoch below 2 and no misses: the next kind, one letter.
; Epoch 2 or more and no misses: the next kind, the whole word.
; A miss picks the word that contains the hottest letter.

(export glyphlings:choose glyphlings:commit-spawn!)

(require "aura/project" all:)
(require "std/hot-strategy" all:)

(define (glyphlings:word-of src kind)
  (let ((hit (glyphlings:frozen (string-append "word-" kind "-word"))))
    (if (string? hit)
      (glyphlings:strip hit)
      (glyphlings:inner src (string-append "word-" kind "-word")))))

(define (glyphlings:word-score misses word)
  (let ((n (string-length word)) (i 0) (s 0))
    (while (lambda () (< i n))
      (lambda ()
        (set! s (+ s (glyphlings:miss-get misses (substring word i (+ i 1)))))
        (set! i (+ i 1))))
    s))

(define (glyphlings:all-zero? misses)
  (let ((az "abcdefghijklmnopqrstuvwxyz") (i 0) (any #f))
    (while (lambda () (< i 26))
      (lambda ()
        (if (> (glyphlings:miss-get misses (substring az i (+ i 1))) 0)
          (set! any #t)
          #t)
        (set! i (+ i 1))))
    (equal? any #f)))

(define (glyphlings:hot misses)
  (let ((az "abcdefghijklmnopqrstuvwxyz") (i 0) (best-i 0) (best-n 0))
    (while (lambda () (< i 26))
      (lambda ()
        (let ((n (glyphlings:miss-get misses (substring az i (+ i 1)))))
          (if (> n best-n)
            (begin (set! best-n n) (set! best-i i))
            #t))
        (set! i (+ i 1))))
    (substring az best-i (+ best-i 1))))

(define (glyphlings:nth kinds i)
  (if (= i 0) (car kinds) (glyphlings:nth (cdr kinds) (- i 1))))

(define (glyphlings:kind-index kinds k n)
  (if (not (pair? kinds))
    -1
    (if (string=? (car kinds) k)
      n
      (glyphlings:kind-index (cdr kinds) k (+ n 1)))))

(define (glyphlings:best kinds misses hot src)
  (let ((ks kinds) (best #f) (best-s -1))
    (while (lambda () (pair? ks))
      (lambda ()
        (let ((k (car ks))
              (w (glyphlings:word-of src k)))
          (if (and (string? w) (glyphlings:contains? w hot))
            (let ((s (glyphlings:word-score misses w)))
              (if (> s best-s)
                (begin (set! best k) (set! best-s s))
                #t))
            #t))
        (set! ks (cdr ks))))
    best))

(define (glyphlings:yield kinds misses hot src k)
  (let ((n (glyphlings:count kinds))
        (start (glyphlings:kind-index kinds k 0))
        (step 1)
        (found #f))
    (while (lambda () (and (equal? found #f) (<= step 7)))
      (lambda ()
        (let ((sum (+ start step)))
          (let ((idx (if (>= sum n) (- sum n) sum)))
            (let ((cand (glyphlings:nth kinds idx))
                  (w (glyphlings:word-of src cand)))
              (if (and (string? w) (glyphlings:contains? w hot))
                (set! found cand)
                (set! step (+ step 1))))))))
    (if (string? found) (list found "word") (list k "word"))))

(define (glyphlings:choose src misses kind epoch)
  (let ((kinds (glyphlings:kind-list src)))
    (if (glyphlings:all-zero? misses)
      (let ((idx (glyphlings:kind-index kinds kind 0)))
        (let ((nxt (if (< idx 0) "cat"
                     (glyphlings:nth kinds (if (>= (+ idx 1) (glyphlings:count kinds))
                                            0
                                            (+ idx 1))))))
          (if (and (number? epoch) (>= epoch 2))
            (list nxt "word")
            (list nxt "letter"))))
      (let ((hot (glyphlings:hot misses)))
        (let ((best (glyphlings:best kinds misses hot src)))
          (if (not (string? best))
            (list kind "word")
            (if (string=? best kind)
              (glyphlings:yield kinds misses hot src kind)
              (list best "word"))))))))

(define (glyphlings:commit-spawn! src kind mode)
  (let ((name (string-append "body-" kind "-" mode)))
    (let ((hit (glyphlings:frozen name)))
      (let ((body (if (string? hit) hit (glyphlings:value-src src name))))
        (if (not (and (string? body) (> (string-length body) 0) (= (string-ref body 0) 40)))
          (list #f "unknown-body")
          (let ((r (hot-strategy:swap! "next-spawn" body "glyphlings-spawn")))
            (if (equal? (car r) #t)
              (list #t "none")
              (list #f "swap"))))))))
