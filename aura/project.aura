; Projection and source slicing. No mutate, no word list, no scene id.
; glyphlings:frame slices a source string for tests.
; Inventory literals never change: one walk caches them.
; The playable picture is the single live literal. One incremental
; replace of that literal is the whole keystroke.

(export glyphlings:index glyphlings:contains? glyphlings:parse-value
        glyphlings:value-src glyphlings:inner glyphlings:strip glyphlings:num
        glyphlings:kind-list glyphlings:big glyphlings:tricky
        glyphlings:frame glyphlings:picture glyphlings:quote-src glyphlings:miss-get
        glyphlings:define-names glyphlings:count glyphlings:name-in?
        glyphlings:same-names?
        glyphlings:u32 glyphlings:source-section
        glyphlings:inventory-cache! glyphlings:frozen glyphlings:cached-glyphs
        glyphlings:field-at glyphlings:split-bar glyphlings:nth
        glyphlings:set-nth glyphlings:join-bar glyphlings:live-field)

(define (glyphlings:index text substr start)
  (let ((n (string-length text))
        (m (string-length substr))
        (i start)
        (found -1))
    (while (lambda () (and (< found 0) (<= i (- n m))))
      (lambda ()
        (if (string=? (substring text i (+ i m)) substr)
          (set! found i)
          (set! i (+ i 1)))))
    found))

(define (glyphlings:contains? text substr)
  (not (= (glyphlings:index text substr 0) -1)))

(define (glyphlings:parse-value src pos)
  (let ((n (string-length src))
        (c (string-ref src pos)))
    (cond
      ((= c 34)
       (let ((j (+ pos 1)))
         (while (lambda () (and (< j n) (not (= (string-ref src j) 34))))
           (lambda () (set! j (+ j 1))))
         (substring src pos (+ j 1))))
      ((= c 40)
       (let ((j pos) (depth 0) (inq #f))
         (while (lambda () (and (< j n) (or (> depth 0) (= j pos))))
           (lambda ()
             (let ((ch (string-ref src j)))
               (if (equal? inq #t)
                 (if (= ch 34) (set! inq #f) #t)
                 (cond
                   ((= ch 34) (set! inq #t))
                   ((= ch 40) (set! depth (+ depth 1)))
                   ((= ch 41) (set! depth (- depth 1)))
                   (#t #t))))
             (set! j (+ j 1))))
         (substring src pos j)))
      (#t
       (let ((j pos))
         (while (lambda () (and (< j n)
                                (not (= (string-ref src j) 32))
                                (not (= (string-ref src j) 41))
                                (not (= (string-ref src j) 10))))
           (lambda () (set! j (+ j 1))))
         (substring src pos j))))))

(define (glyphlings:value-src src name)
  (let ((key (string-append "(define " name " ")))
    (let ((at (glyphlings:index src key 0)))
      (if (< at 0)
        #f
        (glyphlings:parse-value src (+ at (string-length key)))))))

(define (glyphlings:strip v)
  (if (not (string? v))
    #f
    (if (and (>= (string-length v) 2) (= (string-ref v 0) 34))
      (substring v 1 (- (string-length v) 1))
      v)))

(define (glyphlings:field-at name)
  (cond
    ((string=? name "creature-kind") 0)
    ((string=? name "creature-word") 1)
    ((string=? name "creature-label") 2)
    ((string=? name "spawn-mode") 3)
    ((string=? name "creature-head") 4)
    ((string=? name "creature-body") 5)
    ((string=? name "creature-tail") 6)
    ((string=? name "expect") 7)
    ((string=? name "progress") 8)
    ((string=? name "epoch") 9)
    ((string=? name "zoo") 10)
    ((string=? name "pheromone-table") 11)
    (#t -1)))

(define (glyphlings:split-bar s)
  (if (not (string? s))
    #f
    (let ((n (string-length s)) (i 0) (start 0) (acc (list)) (count 0))
      (while (lambda () (<= i n))
        (lambda ()
          (if (or (= i n) (= (string-ref s i) 124))
            (begin
              (set! acc (cons (substring s start i) acc))
              (set! count (+ count 1))
              (set! start (+ i 1)))
            #t)
          (set! i (+ i 1))))
      (if (= count 12) (reverse acc) #f))))

(define (glyphlings:nth xs i)
  (let ((p xs) (k 0) (found #f))
    (while (lambda () (and (equal? found #f) (pair? p)))
      (lambda ()
        (if (= k i) (set! found (car p)) #t)
        (set! k (+ k 1))
        (set! p (cdr p))))
    found))

(define (glyphlings:set-nth xs i v)
  (let ((p xs) (k 0) (acc (list)))
    (while (lambda () (pair? p))
      (lambda ()
        (set! acc (cons (if (= k i) v (car p)) acc))
        (set! k (+ k 1))
        (set! p (cdr p))))
    (reverse acc)))

(define (glyphlings:join-bar fields)
  (let ((p fields) (acc "") (first #t))
    (while (lambda () (pair? p))
      (lambda ()
        (if (equal? first #t)
          (set! first #f)
          (set! acc (string-append acc "|")))
        (set! acc (string-append acc (car p)))
        (set! p (cdr p))))
    acc))

(define (glyphlings:live-field text name)
  (let ((xs (glyphlings:split-bar text))
        (i (glyphlings:field-at name)))
    (if (and (pair? xs) (number? i) (>= i 0))
      (glyphlings:nth xs i)
      #f)))

(define (glyphlings:inner src name)
  (let ((i (glyphlings:field-at name)))
    (if (and (number? i) (>= i 0))
      (glyphlings:live-field (glyphlings:strip (glyphlings:value-src src "live")) name)
      (glyphlings:strip (glyphlings:value-src src name)))))

(define (glyphlings:num src name)
  (let ((v (glyphlings:inner src name)))
    (if (not (string? v))
      -1
      (let ((n (string->number v)))
        (if (number? n) n -1)))))

(define (glyphlings:kind-list-scan src)
  (let ((pos 0) (acc (list)) (n (string-length src)))
    (while (lambda () (>= pos 0))
      (lambda ()
        (let ((at (glyphlings:index src "(define label-" pos)))
          (if (< at 0)
            (set! pos -1)
            (let ((start (+ at 14))
                  (j (+ at 14)))
              (while (lambda () (and (< j n) (not (= (string-ref src j) 32))))
                (lambda () (set! j (+ j 1))))
              (set! acc (cons (substring src start j) acc))
              (set! pos j))))))
    (reverse acc)))

(define *glyph-inv* #f)
(define *glyph-kinds* #f)
(define *glyph-glyphs* #f)
(define *ink-paint* #f)

(define (glyphlings:paint-mask mask)
  (if (or (not (string? mask)) (not (= (string-length mask) 120)))
    ""
    (let ((row 0) (acc ""))
      (while (lambda () (< row 12))
        (lambda ()
          (let ((col 0)
                (line "\x1b[48;2;18;32;64m\x1b[38;2;255;220;90m ")
                (base (* row 10)))
            (while (lambda () (< col 10))
              (lambda ()
                (set! line (string-append line
                             (if (= (string-ref mask (+ base col)) 49)
                               "██"
                               "  ")))
                (set! col (+ col 1))))
            (set! acc (string-append acc line " \x1b[0m\n")))
          (set! row (+ row 1))))
      acc)))

(define (glyphlings:kind-list src)
  (if (pair? *glyph-kinds*)
    *glyph-kinds*
    (glyphlings:kind-list-scan src)))

(define (glyphlings:frozen name)
  (if (not (hash? *glyph-inv*))
    #f
    (let ((v (hash-ref *glyph-inv* name)))
      (if (string? v) v #f))))

(define (glyphlings:cached-glyphs) *glyph-glyphs*)

(define (glyphlings:starts? s pre)
  (let ((n (string-length pre)))
    (and (string? s) (>= (string-length s) n) (string=? (substring s 0 n) pre))))

(define (glyphlings:keep-frozen? name)
  (or (glyphlings:starts? name "letter-")
      (glyphlings:starts? name "word-")
      (glyphlings:starts? name "label-")
      (glyphlings:starts? name "part-")
      (glyphlings:starts? name "ink-")
      (glyphlings:starts? name "body-")
      (glyphlings:starts? name "stage0-")
      (string=? name "expect-blank")
      (string=? name "zoo-empty")
      (string=? name "next-spawn")))

(define (glyphlings:inventory-cache! src)
  (let ((n (string-length src))
        (i 0)
        (tab (hash))
        (kinds (list))
        (glyphs (list))
        (ink (hash)))
    (while (lambda () (< i n))
      (lambda ()
        (if (and (= (string-ref src i) 40)
                 (<= (+ i 8) n)
                 (string=? (substring src i (+ i 8)) "(define "))
          (let ((start (+ i 8))
                (j (+ i 8)))
            (while (lambda () (and (< j n)
                                   (not (= (string-ref src j) 32))
                                   (not (= (string-ref src j) 41))))
              (lambda () (set! j (+ j 1))))
            (let ((name (substring src start j)))
              (if (< (+ j 1) n)
                (let ((body (glyphlings:parse-value src (+ j 1))))
                  (if (glyphlings:keep-frozen? name)
                    (hash-set! tab name body)
                    #t)
                  (if (glyphlings:starts? name "label-")
                    (set! kinds (cons (substring name 6 (string-length name)) kinds))
                    #t)
                  (if (and (glyphlings:starts? name "part-") (string? body))
                    (set! glyphs (cons (glyphlings:strip body) glyphs))
                    #t))
                #t))
            (set! i (+ j 1)))
          (set! i (+ i 1)))))
    (set! *glyph-kinds* (reverse kinds))
    (set! *glyph-glyphs* glyphs)
    (set! *glyph-inv* tab)
    (set! *ink-paint* ink)
    #t))

(define (glyphlings:define-names src)
  (let ((pos 0) (acc (list)) (n (string-length src)))
    (while (lambda () (>= pos 0))
      (lambda ()
        (let ((at (glyphlings:index src "(define " pos)))
          (if (< at 0)
            (set! pos -1)
            (let ((start (+ at 8))
                  (j (+ at 8)))
              (while (lambda () (and (< j n)
                                     (not (= (string-ref src j) 32))
                                     (not (= (string-ref src j) 41))))
                (lambda () (set! j (+ j 1))))
              (set! acc (cons (substring src start j) acc))
              (set! pos j))))))
    (reverse acc)))

(define (glyphlings:count xs)
  (let ((n 0) (p xs))
    (while (lambda () (pair? p))
      (lambda ()
        (set! n (+ n 1))
        (set! p (cdr p))))
    n))

(define (glyphlings:name-in? name names)
  (let ((xs names) (found #f))
    (while (lambda () (and (equal? found #f) (pair? xs)))
      (lambda ()
        (if (string=? (car xs) name) (set! found #t) #t)
        (set! xs (cdr xs))))
    (equal? found #t)))

(define (glyphlings:same-names? a b)
  (if (not (= (glyphlings:count a) (glyphlings:count b)))
    #f
    (let ((p a) (ok #t))
      (while (lambda () (and (equal? ok #t) (pair? p)))
        (lambda ()
          (if (glyphlings:name-in? (car p) b) #t (set! ok #f))
          (set! p (cdr p))))
      (equal? ok #t))))

(define (glyphlings:u32 s i)
  (if (> (+ i 4) (string-length s))
    -1
    (+ (string-ref s i)
       (* 256 (string-ref s (+ i 1)))
       (* 65536 (string-ref s (+ i 2)))
       (* 16777216 (string-ref s (+ i 3))))))

(define (glyphlings:source-section blob)
  (if (or (not (string? blob)) (< (string-length blob) 24))
    #f
    (if (not (and (string=? (substring blob 0 8) "AURASOUL")
                  (= (string-ref blob 8) 1)))
      #f
      (let ((pos 21) (guard 0) (found #f) (done #f))
        (while (lambda () (and (equal? done #f) (< guard 8)))
          (lambda ()
            (let ((tag (glyphlings:u32 blob pos))
                  (len (glyphlings:u32 blob (+ pos 4))))
              (if (or (< tag 0) (< len 0) (> (+ pos 8 len) (string-length blob)))
                (set! done #t)
                (if (or (= tag 4294967295) (= tag 1))
                  (begin
                    (if (= tag 1)
                      (set! found (substring blob (+ pos 8) (+ pos 8 len)))
                      #t)
                    (set! done #t))
                  (set! pos (+ pos 8 len)))))
            (set! guard (+ guard 1))))
        found))))

(define (glyphlings:quote-src s)
  (string-append "\"" s "\""))

(define (glyphlings:miss-get misses ch)
  (if (not (hash? misses))
    0
    (let ((v (hash-ref misses ch)))
      (if (number? v) v 0))))

(define (glyphlings:big ch)
  (if (or (not (string? ch)) (not (= (string-length ch) 1)))
    ""
    (let ((hit (if (hash? *ink-paint*) (hash-ref *ink-paint* ch) #f)))
      (if (string? hit)
        hit
        (let ((mask (glyphlings:strip
                      (glyphlings:frozen (string-append "ink-" ch)))))
          (if (not (string? mask))
            ""
            (let ((pic (glyphlings:paint-mask mask)))
              (if (and (hash? *ink-paint*) (string? pic))
                (hash-set! *ink-paint* ch pic)
                #t)
              pic)))))))

(define (glyphlings:spell word progress)
  (if (or (not (string? word)) (< (string-length word) 2) (not (number? progress))
          (< progress 0))
    ""
    (let ((i 0) (n (string-length word)) (acc ""))
      (while (lambda () (< i n))
        (lambda ()
          (let ((ch (substring word i (+ i 1))))
            (if (> i 0) (set! acc (string-append acc "  ")) #t)
            (set! acc (string-append acc
                        (if (= i progress)
                          (string-append "\x1b[1m\x1b[33m" ch "\x1b[0m")
                          (if (< i progress)
                            (string-append "\x1b[32m" ch "\x1b[0m")
                            (string-append "\x1b[2m" ch "\x1b[0m"))))))
          (set! i (+ i 1))))
      acc)))

(define (glyphlings:tricky misses)
  (let ((az "abcdefghijklmnopqrstuvwxyz")
        (best1 "") (n1 0) (best2 "") (n2 0) (best3 "") (n3 0)
        (i 0))
    (while (lambda () (< i 26))
      (lambda ()
        (let ((ch (substring az i (+ i 1)))
              (n (glyphlings:miss-get misses ch)))
          (cond
            ((> n n1)
             (set! best3 best2) (set! n3 n2)
             (set! best2 best1) (set! n2 n1)
             (set! best1 ch) (set! n1 n))
            ((> n n2)
             (set! best3 best2) (set! n3 n2)
             (set! best2 ch) (set! n2 n))
            ((> n n3)
             (set! best3 ch) (set! n3 n))
            (#t #t)))
        (set! i (+ i 1))))
    (if (= n1 0)
      "今天还没有容易错的字母"
      (string-append "今天容易写错的字母：" best1
                     (if (> n2 0) (string-append " " best2) "")
                     (if (> n3 0) (string-append " " best3) "")))))

(define (glyphlings:picture want head body tail label zoo wobble banner misses word mode progress)
  (if (or (not (string? head)) (not (string? want)) (not (string? body))
          (not (string? tail)) (not (string? label)) (not (string? zoo)))
    "我们再玩这一只\n"
    (string-append
      "\x1b[H"
      (if (and (string? want) (= (string-length want) 1))
        (string-append "\x1b[1m请按这个键  " want "\x1b[0m\n")
        "看小兽\n")
      (glyphlings:big want)
      (if (and (string? want) (= (string-length want) 1))
        (if (and (string? mode) (string=? mode "coach"))
          (string-append "按完这几个字母，小兽才长齐\n"
                         (glyphlings:spell word progress) "\n")
          (if (and (string? mode) (string=? mode "word"))
            (string-append "按完这三个字母，小兽才长齐\n"
                           (glyphlings:spell word progress) "\n")
            "按这一个字母，小兽就出来\n"))
        "")
      head " " body " " tail "   " label "\n"
      zoo "\n"
      (if (and (string? banner) (> (string-length banner) 0))
        (string-append banner "\n")
        "")
      (if (equal? wobble #t)
        (if (and (string? want) (= (string-length want) 1))
          (string-append "再试一次，按 " want "\n")
          "再试一次\n")
        "")
      "\x1b[2m" (glyphlings:tricky misses) "\x1b[0m\n"
      "\x1b[J")))

(define (glyphlings:frame src wobble banner misses)
  (glyphlings:picture
    (glyphlings:inner src "expect")
    (glyphlings:inner src "creature-head")
    (glyphlings:inner src "creature-body")
    (glyphlings:inner src "creature-tail")
    (glyphlings:inner src "creature-label")
    (glyphlings:inner src "zoo")
    wobble banner misses
    (glyphlings:inner src "creature-word")
    (glyphlings:inner src "spawn-mode")
    (glyphlings:num src "progress")))
