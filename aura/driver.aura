; Keystroke door. The child never becomes a form.
; Rebind text is copied from literals already in the workspace.

(export glyphlings:install! glyphlings:on-line glyphlings:accept!
        glyphlings:backspace! glyphlings:commit! glyphlings:arm!
        glyphlings:boot glyphlings:loop glyphlings:paint glyphlings:save
        glyphlings:snap-main)

(require "std/mutate" all:)
(require "std/ant" all:)
(require "std/hot-strategy" all:)
(require "aura/project" all:)
(require "aura/spawn" all:)

(define *miss* (hash))
(define *wobble* #f)
(define *banner* "")
(define *running* #t)
(define *glyph-zoo* -1)
(define *glyph-good-snap* -1)
(define *last-fault* "none")
(define *t0* 0)

(define (glyphlings:snap-main)
  (let ((p (getenv "GLYPHLINGS_SNAP")))
    (if (and (string? p) (> (string-length p) 0))
      p
      "runtime/session.aura-snap")))

(define (glyphlings:snap-writing)
  (string-append (glyphlings:snap-main) ".writing"))

(define (glyphlings:paint)
  (display (glyphlings:frame (current-source :workspace) *wobble* *banner* *miss*))
  (set! *wobble* #f)
  (set! *banner* ""))

(define (glyphlings:pause)
  (if (string? (getenv "GLYPHLINGS_FAST"))
    #t
    (let ((t (monotonic-ms)))
      (while (lambda () (< (- (monotonic-ms) t) 900))
        (lambda () #t)))))

(define (glyphlings:miss-bump ch)
  (let ((n (glyphlings:miss-get *miss* ch)))
    (hash-set! *miss* ch (if (< n 99) (+ n 1) 99))))

(define (glyphlings:digits)
  (let ((az "abcdefghijklmnopqrstuvwxyz") (i 0) (acc ""))
    (while (lambda () (< i 26))
      (lambda ()
        (let ((n (glyphlings:miss-get *miss* (substring az i (+ i 1)))))
          (set! acc (string-append acc
                                   (if (< n 10) "0" "")
                                   (number->string n))))
        (set! i (+ i 1))))
    acc))

(define (glyphlings:allowed-name? n)
  (or (string=? n "creature-kind") (string=? n "creature-word")
      (string=? n "creature-label") (string=? n "spawn-mode")
      (string=? n "creature-head") (string=? n "creature-body")
      (string=? n "creature-tail") (string=? n "expect")
      (string=? n "progress") (string=? n "epoch")
      (string=? n "zoo") (string=? n "pheromone-table")))

(define (glyphlings:batch-body ops name)
  (let ((p ops) (found #f))
    (while (lambda () (and (equal? found #f) (pair? p)))
      (lambda ()
        (let ((op (car p)))
          (if (and (pair? op) (pair? (cdr op)) (string=? (car op) name))
            (set! found (car (cdr op)))
            #t))
        (set! p (cdr p))))
    found))

(define (glyphlings:eff src ops name)
  (let ((b (glyphlings:batch-body ops name)))
    (if (string? b) (glyphlings:strip b) (glyphlings:inner src name))))

(define (glyphlings:part-glyphs src)
  (let ((pos 0) (acc (list)) (n (string-length src)))
    (while (lambda () (>= pos 0))
      (lambda ()
        (let ((at (glyphlings:index src "(define part-" pos)))
          (if (< at 0)
            (set! pos -1)
            (let ((j (+ at 8)))
              (while (lambda () (and (< j n) (not (= (string-ref src j) 32))))
                (lambda () (set! j (+ j 1))))
              (set! acc (cons (glyphlings:strip (glyphlings:parse-value src (+ j 1))) acc))
              (set! pos (+ j 1)))))))
    acc))

(define (glyphlings:longest glyphs z i)
  (let ((p glyphs) (best 0) (n (string-length z)))
    (while (lambda () (pair? p))
      (lambda ()
        (let ((g (car p)))
          (if (and (string? g) (> (string-length g) best)
                   (<= (+ i (string-length g)) n)
                   (string=? (substring z i (+ i (string-length g))) g))
            (set! best (string-length g))
            #t))
        (set! p (cdr p))))
    best))

(define (glyphlings:zoo-consumed? src z)
  (if (not (string? z))
    #f
    (let ((glyphs (glyphlings:part-glyphs src))
          (i 0) (n (string-length z)) (ok #t) (need #t))
      (while (lambda () (and (equal? ok #t) (< i n)))
        (lambda ()
          (if (and (equal? need #f) (= (string-ref z i) 32))
            (begin (set! i (+ i 1)) (set! need #t))
            (let ((g (glyphlings:longest glyphs z i)))
              (if (< g 1)
                (set! ok #f)
                (begin (set! i (+ i g)) (set! need #f)))))))
      (and (equal? ok #t) (or (= n 0) (equal? need #f))))))

(define (glyphlings:all-digits? s)
  (let ((i 0) (n (string-length s)) (ok #t))
    (while (lambda () (and (equal? ok #t) (< i n)))
      (lambda ()
        (let ((c (string-ref s i)))
          (if (and (>= c 48) (<= c 57)) #t (set! ok #f)))
        (set! i (+ i 1))))
    (equal? ok #t)))

(define (glyphlings:int-body? body lo hi)
  (let ((n (string->number body)))
    (and (number? n) (>= n lo) (<= n hi) (string=? body (number->string n)))))

(define (glyphlings:body-ok? src ops name body)
  (cond
    ((string=? name "creature-kind")
     (glyphlings:name-in? (glyphlings:strip body) (glyphlings:kind-list src)))
    ((string=? name "spawn-mode")
     (let ((m (glyphlings:strip body)))
       (or (string=? m "letter") (string=? m "word"))))
    ((string=? name "creature-word")
     (let ((k (glyphlings:eff src ops "creature-kind"))
           (m (glyphlings:eff src ops "spawn-mode")))
       (let ((want (glyphlings:value-src src (string-append "word-" k "-" m))))
         (and (string? want) (string=? body want)))))
    ((string=? name "creature-label")
     (let ((k (glyphlings:eff src ops "creature-kind")))
       (let ((want (glyphlings:value-src src (string-append "label-" k))))
         (and (string? want) (string=? body want)))))
    ((string=? name "expect")
     (let ((blank (glyphlings:value-src src "expect-blank"))
           (word (glyphlings:eff src ops "creature-word"))
           (inner (glyphlings:strip body)))
       (or (and (string? blank) (string=? body blank))
           (and (string? inner) (= (string-length inner) 1) (string? word)
                (glyphlings:contains? word inner)
                (string=? body (glyphlings:value-src src (string-append "letter-" inner)))))))
    ((string=? name "creature-head")
     (let ((egg (glyphlings:value-src src "stage0-head"))
           (k (glyphlings:eff src ops "creature-kind"))
           (m (glyphlings:eff src ops "spawn-mode"))
           (step (glyphlings:eff src ops "progress")))
       (or (and (string? egg) (string=? body egg))
           (and (string? step)
                (string=? body (glyphlings:value-src src
                                (string-append "part-" k "-" m "-" step "-head")))))))
    ((or (string=? name "creature-body") (string=? name "creature-tail"))
     (let ((dot (glyphlings:value-src src "stage0-rest"))
           (k (glyphlings:eff src ops "creature-kind"))
           (m (glyphlings:eff src ops "spawn-mode"))
           (step (glyphlings:eff src ops "progress"))
           (slot (if (string=? name "creature-body") "body" "tail")))
       (or (and (string? dot) (string=? body dot))
           (and (string? step)
                (string=? body (glyphlings:value-src src
                                (string-append "part-" k "-" m "-" step "-" slot)))))))
    ((string=? name "progress") (glyphlings:int-body? body 0 3))
    ((string=? name "epoch") (glyphlings:int-body? body 0 6))
    ((string=? name "zoo")
     (or (string=? body (glyphlings:value-src src "zoo-empty"))
         (glyphlings:zoo-consumed? src (glyphlings:strip body))))
    ((string=? name "pheromone-table")
     (let ((d (glyphlings:strip body)))
       (and (string? d) (= (string-length d) 52) (glyphlings:all-digits? d)
            (string=? body (glyphlings:quote-src d)))))
    (#t #f)))

(define (glyphlings:pairs-ok? src pairs)
  (let ((ok #t) (p pairs))
    (while (lambda () (and (equal? ok #t) (pair? p)))
      (lambda ()
        (let ((item (car p)))
          (let ((good (try
                        (and (pair? item) (pair? (cdr item))
                             (string? (car item)) (string? (car (cdr item)))
                             (glyphlings:allowed-name? (car item))
                             (glyphlings:body-ok? src pairs (car item)
                                                  (car (cdr item))))
                        (catch (e) #f))))
            (if (equal? good #t) #t (set! ok #f))))
        (set! p (cdr p))))
    (and (pair? pairs) (equal? ok #t))))

(define (glyphlings:restore-id id)
  (if (>= id 0)
    (let ((r (ast:restore id)))
      (if (equal? r #t)
        (begin (eval-current) #t)
        (begin
          (set! *last-fault* "restore")
          (equal? (hot-strategy:heal!) #t))))
    #f))

(define (glyphlings:dirty!)
  (if (glyphlings:restore-id *glyph-good-snap*)
    (set! *banner* "我们再玩这一只")
    (if (glyphlings:restore-id *glyph-zoo*)
      (set! *banner* "我们再玩这一只")
      (begin
        (glyphlings:install! "aura/seed.aura")
        (set! *banner* "我们从头再来一只小猫")))))

(define (glyphlings:commit! pairs)
  (let ((before (current-source :workspace)))
    (if (or (equal? (mutate:boundary-safe?) #f)
            (equal? (mutate:quota-ok?) #f)
            (not (equal? (glyphlings:pairs-ok? before pairs) #t)))
      #f
      (let ((ops (list)) (p pairs))
        (while (lambda () (pair? p))
          (lambda ()
            (set! ops (cons (list "mutate:rebind"
                                  (car (car p))
                                  (car (cdr (car p)))
                                  "glyphlings")
                            ops))
            (set! p (cdr p))))
        (set! ops (reverse ops))
        (let ((r (mutate:atomic-batch-safe ops "glyphlings")))
          (if (equal? r #t)
            #t
            (begin
              (set! *last-fault* "rebind")
              (if (equal? before (current-source :workspace))
                #f
                (begin (glyphlings:dirty!) #f)))))))))

(define (glyphlings:slot-name step)
  (cond ((= step 1) "head") ((= step 2) "body") ((= step 3) "tail") (#t #f)))

(define (glyphlings:stage0-body src slot)
  (if (string=? slot "head")
    (glyphlings:value-src src "stage0-head")
    (glyphlings:value-src src "stage0-rest")))

(define (glyphlings:stage0! kind mode)
  (let ((src (current-source :workspace)))
    (let ((word (glyphlings:inner src (string-append "word-" kind "-" mode))))
      (if (not (and (string? word) (> (string-length word) 0)))
        #f
        (let ((ch (substring word 0 1)))
          (glyphlings:commit! (list
            (list "creature-kind" (glyphlings:quote-src kind))
            (list "creature-word" (glyphlings:value-src src (string-append "word-" kind "-" mode)))
            (list "creature-label" (glyphlings:value-src src (string-append "label-" kind)))
            (list "spawn-mode" (glyphlings:quote-src mode))
            (list "creature-head" (glyphlings:value-src src "stage0-head"))
            (list "creature-body" (glyphlings:value-src src "stage0-rest"))
            (list "creature-tail" (glyphlings:value-src src "stage0-rest"))
            (list "expect" (glyphlings:value-src src (string-append "letter-" ch)))
            (list "progress" "0"))))))))

(define (glyphlings:piece src kind mode)
  (let ((h (glyphlings:inner src (string-append "part-" kind "-" mode "-1-head"))))
    (if (string=? mode "letter")
      h
      (string-append h
        (glyphlings:inner src (string-append "part-" kind "-" mode "-2-body"))
        (glyphlings:inner src (string-append "part-" kind "-" mode "-3-tail"))))))

(define (glyphlings:roundtrip-ok?)
  (let ((a (current-source :workspace)))
    (set-code a)
    (eval-current)
    (equal? a (current-source :workspace))))

(define (glyphlings:after-hatch old-kind old-mode)
  (let ((src (current-source :workspace))
        (ep (glyphlings:num (current-source :workspace) "epoch")))
    (set! *banner* "孵出来啦")
    (glyphlings:paint)
    (glyphlings:pause)
    (if (= ep 6)
      (begin (set! *running* #f) (glyphlings:save))
      (begin
        (set! *glyph-zoo* (ast:snapshot "glyph-zoo"))
        (let ((chosen (glyphlings:choose src *miss* old-kind)))
          (let ((new-kind (car chosen))
                (new-mode (car (cdr chosen)))
                (sw (glyphlings:commit-spawn! src new-kind new-mode)))
            (if (not (equal? (car sw) #t))
              (begin
                (set! *last-fault* "swap")
                (set! *banner* "我们再玩这一只")
                (glyphlings:stage0! old-kind old-mode))
              (if (not (equal? (glyphlings:roundtrip-ok?) #t))
                (begin
                  (set! *last-fault* "roundtrip")
                  (glyphlings:restore-id *glyph-zoo*)
                  (set! *banner* "我们再玩这一只")
                  (glyphlings:stage0! old-kind old-mode))
                (begin
                  (set! *glyph-good-snap* (ast:snapshot "glyph-good"))
                  (if (not (equal? (glyphlings:stage0! new-kind new-mode) #t))
                    (begin
                      (glyphlings:restore-id *glyph-good-snap*)
                      (if (not (equal? (glyphlings:stage0! new-kind new-mode) #t))
                        (glyphlings:dirty!)
                        (glyphlings:save)))
                    (glyphlings:save)))))))))))

(define (glyphlings:accept-partial src kind mode step)
  (let ((slot (glyphlings:slot-name step))
        (word (glyphlings:inner src "creature-word")))
    (let ((part (glyphlings:value-src src
                  (string-append "part-" kind "-" mode "-" (number->string step) "-" slot)))
          (ch (substring word step (+ step 1))))
      (let ((expect-body (glyphlings:value-src src (string-append "letter-" ch)))
            (pairs (list
                     (list (string-append "creature-" slot) part)
                     (list "expect" expect-body)
                     (list "progress" (number->string step)))))
        (if (equal? (glyphlings:commit! pairs) #t)
          #t
          (if (string=? *banner* "") (set! *wobble* #t) #t))))))

(define (glyphlings:hatch src kind mode step)
  (let ((slot (glyphlings:slot-name step))
        (old-zoo (glyphlings:inner src "zoo"))
        (ep (glyphlings:num src "epoch")))
    (let ((part (glyphlings:value-src src
                  (string-append "part-" kind "-" mode "-" (number->string step) "-" slot)))
          (piece (glyphlings:piece src kind mode))
          (joined (if (or (not (string? old-zoo)) (string=? old-zoo ""))
                    (glyphlings:piece src kind mode)
                    (string-append old-zoo " " (glyphlings:piece src kind mode)))))
      (let ((pairs (list
                     (list (string-append "creature-" slot) part)
                     (list "zoo" (glyphlings:quote-src joined))
                     (list "epoch" (number->string (+ ep 1)))
                     (list "pheromone-table" (glyphlings:quote-src (glyphlings:digits)))
                     (list "expect" (glyphlings:value-src src "expect-blank"))
                     (list "progress" (number->string step)))))
        (if (equal? (glyphlings:commit! pairs) #t)
          (glyphlings:after-hatch kind mode)
          (if (string=? *banner* "") (set! *wobble* #t) #t))))))

(define (glyphlings:accept!)
  (let ((src (current-source :workspace)))
    (let ((kind (glyphlings:inner src "creature-kind"))
          (mode (glyphlings:inner src "spawn-mode"))
          (word (glyphlings:inner src "creature-word"))
          (progress (glyphlings:num src "progress")))
      (if (not (and (string? kind) (string? mode) (string? word) (>= progress 0)))
        (set! *wobble* #t)
        (let ((step (+ progress 1)))
          (if (< step (string-length word))
            (glyphlings:accept-partial src kind mode step)
            (glyphlings:hatch src kind mode step)))))))

(define (glyphlings:backspace!)
  (let ((src (current-source :workspace)))
    (let ((progress (glyphlings:num src "progress"))
          (word (glyphlings:inner src "creature-word")))
      (if (or (< progress 1) (not (string? word)))
        #t
        (let ((slot (glyphlings:slot-name progress))
              (next (- progress 1)))
          (let ((ch (substring word next (+ next 1))))
            (let ((r (glyphlings:commit! (list
                        (list (string-append "creature-" slot)
                              (glyphlings:stage0-body src slot))
                        (list "expect" (glyphlings:value-src src (string-append "letter-" ch)))
                        (list "progress" (number->string next))))))
              (if (equal? r #t)
                #t
                (if (string=? *banner* "") (set! *wobble* #t) #t)))))))))

(define (glyphlings:on-byte line)
  (let ((c (string-ref line 0)))
    (if (and (>= c 65) (<= c 90))
      (glyphlings:on-byte (substring "abcdefghijklmnopqrstuvwxyz"
                                     (- c 65) (+ (- c 65) 1)))
      (let ((src (current-source :workspace)))
        (cond
          ((or (= c 0) (= c 13)) (set! *wobble* #f))
          ((or (= c 8) (= c 127)) (glyphlings:backspace!))
          ((and (>= c 97) (<= c 122))
           (let ((want (glyphlings:inner src "expect")))
             (if (and (string? want) (string=? line want) (> (string-length want) 0))
               (glyphlings:accept!)
               (begin
                 (if (and (string? want) (= (string-length want) 1))
                   (begin
                     (pheromone:update want 1.0)
                     (glyphlings:miss-bump want))
                   #t)
                 (set! *wobble* #t)))))
          (#t (set! *wobble* #t)))))))

(define (glyphlings:on-line line)
  (if (not (string? line))
    (begin (set! *running* #f) #f)
    (begin
      (cond
        ((string=? line "!")
         (set! *banner* "窗口太小啦，拉大一点再玩")
         (set! *wobble* #f))
        ((= (string-length line) 1) (glyphlings:on-byte line))
        (#t (set! *wobble* #t)))
      (glyphlings:paint)
      #t)))

(define (glyphlings:install! path)
  (let ((text (read-file path)))
    (if (not (string? text))
      #f
      (begin
        (set-code text)
        (eval-current)
        (set! *miss* (hash))
        (set! *wobble* #f)
        (set! *banner* "")
        (set! *running* #t)
        (set! *glyph-zoo* -1)
        (set! *glyph-good-snap* -1)
        (set! *last-fault* "none")
        (set! *t0* (monotonic-ms))
        #t))))

(define (glyphlings:arm!)
  (let ((body (glyphlings:value-src (current-source :workspace) "next-spawn")))
    (if (string? body)
      (hot-strategy:register! "next-spawn" body)
      #f))
  (set! *glyph-zoo* -1)
  (set! *glyph-good-snap* (ast:snapshot "glyph-boot")))

(define (glyphlings:tripped? text)
  (or (glyphlings:contains? text "(require")
      (glyphlings:contains? text "(eval")
      (glyphlings:contains? text "(shell")
      (glyphlings:contains? text "http-")
      (glyphlings:contains? text "write-file")
      (glyphlings:contains? text "(load")
      (glyphlings:contains? text "set-code")
      (glyphlings:contains? text "deserialize-workspace")
      (glyphlings:contains? text "serialize-workspace")
      (glyphlings:contains? text "command-")))

(define (glyphlings:load-miss! src)
  (let ((digits (glyphlings:inner src "pheromone-table"))
        (az "abcdefghijklmnopqrstuvwxyz")
        (i 0))
    (set! *miss* (hash))
    (if (and (string? digits) (= (string-length digits) 52))
      (while (lambda () (< i 26))
        (lambda ()
          (let ((n (string->number (substring digits (* i 2) (+ (* i 2) 2))))
                (ch (substring az i (+ i 1))))
            (if (and (number? n) (> n 0))
              (let ((k 0))
                (hash-set! *miss* ch n)
                (while (lambda () (< k n))
                  (lambda ()
                    (pheromone:update ch 1.0)
                    (set! k (+ k 1)))))
              #t))
          (set! i (+ i 1))))
      #t)))

(define (glyphlings:try-session path)
  (let ((blob (read-file path)))
    (if (not (string? blob))
      #f
      (let ((section (glyphlings:source-section blob)))
        (if (or (not (string? section)) (glyphlings:tripped? section))
          #f
          (if (not (equal? (deserialize-workspace path) #t))
            #f
            (let ((seed (read-file "aura/seed.aura")))
              (if (and (string? seed)
                       (glyphlings:same-names?
                         (glyphlings:define-names (current-source :workspace))
                         (glyphlings:define-names seed)))
                #t
                (begin
                  (if (string? seed) (begin (set-code seed) (eval-current)) #f)
                  #f)))))))))

(define (glyphlings:save)
  (let ((w (serialize-workspace (glyphlings:snap-writing))))
    (if (equal? w #t)
      (equal? (serialize-workspace (glyphlings:snap-main)) #t)
      #f)))

(define (glyphlings:boot)
  (if (equal? (glyphlings:try-session (glyphlings:snap-main)) #t)
    (glyphlings:load-miss! (current-source :workspace))
    (if (equal? (glyphlings:try-session (glyphlings:snap-writing)) #t)
      (glyphlings:load-miss! (current-source :workspace))
      (glyphlings:install! "aura/seed.aura")))
  (glyphlings:arm!)
  (set! *t0* (monotonic-ms))
  (set! *running* #t)
  (glyphlings:paint))

(define (glyphlings:time-up?)
  (let ((now (monotonic-ms)))
    (if (and (number? now) (number? *t0*))
      (>= (- now *t0*) 480000)
      #f)))

(define (glyphlings:loop)
  (while (lambda () (equal? *running* #t))
    (lambda ()
      (if (or (>= (glyphlings:num (current-source :workspace) "epoch") 6)
              (glyphlings:time-up?))
        (begin (set! *running* #f) (glyphlings:save))
        (let ((line (read-line)))
          (if (void? line)
            (begin (set! *running* #f) (glyphlings:save))
            (glyphlings:on-line line)))))))
